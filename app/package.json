{
	"name": "app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run --no-file-parallelism --maxWorkers=1",
		"db:migrate:local": "wrangler d1 migrations apply wastemap-salui --local",
		"db:migrate:remote": "wrangler d1 migrations apply wastemap-salui --remote",
		"db:seed:local": "wrangler d1 execute wastemap-salui --local --file=seed/dev-seed.sql",
		"mod:create": "node scripts/mod-create.mjs",
		"smoke": "node scripts/smoke.mjs",
		"types": "wrangler types",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"wrangler": "^4.166.0"
	},
	"dependencies": {
		"maplibre-gl": "^6.19.0"
	}
}
