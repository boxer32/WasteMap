{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"],
			"$app/*": ["./node_modules/@sveltejs/kit/src/runtime/app/*"]
		}
	},
	"include": ["src", "vite.config.ts", "worker-configuration.d.ts", "./node_modules/@sveltejs/kit/types/index.d.ts"],
	"exclude": ["src/service-worker.ts"]
}
